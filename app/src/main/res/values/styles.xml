<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="CustomTimePickerTheme"  parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:amPmTextColor">#FFFFFF</item>
        <item name="android:textColorHint">#FFFFFF</item>
        <item name="android:numbersTextColor">@color/pinkPrimary</item>
        <item name="android:numbersBackgroundColor">#221F1F</item>
        <item name="android:colorControlNormal">#FFB6C1</item>
        <item name="android:spinnerDropDownItemStyle">@style/TimePickerSpinnerItem</item>
    </style>

    <style name="TimePickerSpinnerItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">#000000</item> <!-- Black text in list -->
    </style>

    <style name="TimerNumberButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/_45sdp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_18ssp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">#33FFB6C1</item>
    </style>

    <style name="DayCircleStyle">
        <item name="android:layout_width">@dimen/_32sdp</item>
        <item name="android:layout_height">@dimen/_32sdp</item>
        <item name="android:layout_margin">@dimen/_2sdp</item>
        <item name="android:background">@drawable/bg_circle_outline</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_11ssp</item>
    </style>

    <style name="h1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/semibold_18</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_22ssp</item>
    </style>

    <style name="h2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/regular_18</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/_22ssp</item>
    </style>

    <style name="h3">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/medium_18</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_15ssp</item>
    </style>

    <style name="p1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/extralight_18</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_13ssp</item>
    </style>

    <style name="p2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:fontFamily">@font/medium_18</item>
    </style>

    <style name="p3">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/regular_18</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_11ssp</item>
    </style>

    <style name="p4">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>

    <style name="p5">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/regular_18</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:layout_marginTop">@dimen/_2sdp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="material_btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/regular_18</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:paddingStart">@dimen/_38sdp</item>
        <item name="android:layout_marginHorizontal">@dimen/_22sdp</item>
        <item name="android:paddingEnd">@dimen/_38sdp</item>
        <item name="android:paddingTop">@dimen/_12sdp</item>
        <item name="android:paddingBottom">@dimen/_12sdp</item>
    </style>

    <style name="btn_back">
        <item name="android:layout_width">@dimen/_28sdp</item>
        <item name="android:layout_height">@dimen/_28sdp</item>
        <item name="android:layout_margin">@dimen/_15sdp</item>
    </style>

    <style name="main_header_icons">
        <item name="android:layout_width">@dimen/_36sdp</item>
        <item name="android:layout_height">@dimen/_36sdp</item>
    </style>


    <style name="DialogTitleText" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorAccent">@color/pinkPrimary</item>
        <item name="android:backgroundTint">#1B1B1F</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>



</resources>