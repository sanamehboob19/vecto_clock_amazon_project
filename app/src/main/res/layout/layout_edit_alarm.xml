<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#0F1113"
    app:cardCornerRadius="@dimen/_28sdp"
    app:cardElevation="0dp"
    app:strokeColor="#1E1E1E"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="@dimen/_25sdp">

        <View
            android:layout_width="@dimen/_35sdp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:alpha="0.3"
            android:background="@color/white"
            android:layout_marginBottom="@dimen/_20sdp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_edit_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:text="09:40 PM"
                android:textColor="@color/white"
                android:textSize="@dimen/_45ssp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_change_time"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                app:cardBackgroundColor="#1B1B1F"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_edit_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_edit_time">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_9sdp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/pinkPrimary" />
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardCornerRadius="@dimen/_20sdp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/ic_clock"
                    app:tint="#888888"/>
                <TextView
                    android:id="@+id/tv_upcoming_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:text="Upcoming: Today (10h 5m)"
                    android:textColor="#888888"
                    android:textSize="@dimen/_9ssp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layout_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_m" style="@style/DayCircleStyle" android:text="M" />
            <TextView android:id="@+id/day_t" style="@style/DayCircleStyle" android:text="T" />
            <TextView android:id="@+id/day_w" style="@style/DayCircleStyle" android:text="W" />
            <TextView android:id="@+id/day_th" style="@style/DayCircleStyle" android:text="T" />
            <TextView android:id="@+id/day_f" style="@style/DayCircleStyle" android:text="F" />
            <TextView android:id="@+id/day_s" style="@style/DayCircleStyle" android:text="S" />
            <TextView android:id="@+id/day_su" style="@style/DayCircleStyle" android:text="S" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_25sdp"
            app:cardBackgroundColor="#1B1B1F"
            app:cardCornerRadius="@dimen/_18sdp"
            app:strokeColor="#2C2C2C"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_15sdp">
                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_more"
                        app:tint="#444444"/>
                    <EditText
                        android:id="@+id/et_alarm_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:background="@android:color/transparent"
                        android:hint="Alarm name"
                        android:textColorHint="#444444"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        android:inputType="textCapSentences"
                        android:singleLine="true"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2C2C2C" android:layout_marginHorizontal="@dimen/_15sdp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:paddingHorizontal="@dimen/_15sdp">
                    <ImageView
                        android:id="@+id/iv_vib"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_timer"
                        app:tint="#444444"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_toEndOf="@id/iv_vib"
                        android:text="Vibrate on ring"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="@dimen/_12ssp" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_vibrate_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:trackTint="@color/switch_track_selector"
                        app:thumbTint="@color/white"
                        app:trackDecorationTint="@android:color/transparent"/>
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2C2C2C" android:layout_marginHorizontal="@dimen/_15sdp"/>

                <RelativeLayout
                    android:id="@+id/row_ringtone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="@dimen/_15sdp">

                    <ImageView
                        android:id="@+id/iv_ringtone_icon"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_alarm"
                        app:tint="#444444"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_toEndOf="@id/iv_ringtone_icon"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alarm Sound"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            android:id="@+id/tv_ringtone_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Default Tone"
                            android:textColor="@color/pinkPrimary"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="#444444" />
                </RelativeLayout>


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_30sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_edit"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete Alarm"
                android:textAllCaps="false"
                android:textColor="#FF5252"
                android:textStyle="bold" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_edit"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_42sdp"
                android:paddingHorizontal="@dimen/_25sdp"
                android:text="Save"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@color/pinkPrimary"
                app:cornerRadius="@dimen/_15sdp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>




