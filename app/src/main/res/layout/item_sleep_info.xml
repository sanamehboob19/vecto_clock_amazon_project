<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#181818"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                app:tint="#FFB6C1"/>
            <TextView android:id="@+id/tv_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/_5sdp" android:textColor="#888888" android:textSize="@dimen/_9ssp" android:textAllCaps="true"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/_5sdp" android:textColor="@color/white" android:textSize="@dimen/_18ssp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_day_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/_10sdp" android:textColor="#555555" android:textSize="@dimen/_8ssp" android:textAllCaps="true"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>