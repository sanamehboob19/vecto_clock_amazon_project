<?xml version="1.0" encoding="utf-8"?>
<!-- LANDSCAPE: fragment_timer.xml — Left=Circle, Right=Controls+Presets -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1113"
    android:orientation="horizontal"
    android:padding="@dimen/_12sdp">

    <!-- LEFT: Timer Circle -->
    <FrameLayout
        android:id="@+id/timer_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.nzdeveloper.androidclock.alarmtimer.stopwatch.widget.TimerCircleView
            android:id="@+id/timer_progress_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_timer_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:text="00:15:00"
                android:textColor="@color/white"
                android:textSize="@dimen/_30ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="REMAINING"
                android:textColor="#444444"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- RIGHT: Controls + Presets -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20sdp">

        <TextView
            android:id="@+id/tv_timer_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text=""
            android:textColor="@color/pinkPrimary"
            android:textSize="@dimen/_8ssp"
            android:textAllCaps="true"
            android:layout_marginBottom="@dimen/_15sdp"/>

        <!-- 1. Edit Button (Focusable) -->
        <ImageView
            android:id="@+id/btn_edit_timer"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_edit"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/bg_focus_highlight"
            android:nextFocusDown="@id/btn_play_pause"
            android:layout_marginBottom="@dimen/_15sdp"
            app:tint="@color/white" />

        <!-- Play/Pause/Reset/Add controls -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Reset Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_reset"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:cardBackgroundColor="#1B1B1F"
                app:cardCornerRadius="@dimen/_12sdp"
                app:strokeWidth="0dp"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusRight="@id/btn_play_pause"
                android:nextFocusUp="@id/btn_edit_timer"
                android:nextFocusDown="@id/preset5m"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_1sdp"
                    android:src="@drawable/ic_reset" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Play/Pause Button (Main Focus) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_play_pause"
                android:layout_width="@dimen/_55sdp"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:cardBackgroundColor="@color/pinkPrimary"
                app:cardCornerRadius="@dimen/_18sdp"
                app:cardElevation="@dimen/_8sdp"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusLeft="@id/btn_reset"
                android:nextFocusRight="@id/btn_add"
                android:nextFocusUp="@id/btn_edit_timer"
                android:nextFocusDown="@id/preset25m"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_add"
                app:layout_constraintStart_toEndOf="@id/btn_reset"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/img_play_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_15sdp"
                    android:src="@drawable/is_pause"
                    app:tint="@color/black" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Add Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_add"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:cardBackgroundColor="#1B1B1F"
                app:cardCornerRadius="@dimen/_12sdp"
                app:strokeWidth="0dp"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusLeft="@id/btn_play_pause"
                android:nextFocusUp="@id/btn_edit_timer"
                android:nextFocusDown="@id/preset15m"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_1sdp"
                    android:src="@drawable/ic_add" />
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Presets Row (TV Focusable) -->
        <LinearLayout
            android:id="@+id/layout_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="@dimen/_15sdp">

            <!-- Make sure the root of item_timer_preset is focusable -->
            <include android:id="@+id/preset5m" layout="@layout/item_timer_preset"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="@dimen/_6sdp" />

            <include android:id="@+id/preset25m" layout="@layout/item_timer_preset"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="@dimen/_6sdp" />

            <include android:id="@+id/preset15m" layout="@layout/item_timer_preset"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
