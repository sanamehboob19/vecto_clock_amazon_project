<?xml version="1.0" encoding="utf-8"?>
<!--
    LANDSCAPE LAYOUT — fragment_clock.xml (layout-land)
    Fire TV / Tablet Landscape: Left = Clock display, Right = Toggle + Info
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1113"
    android:orientation="horizontal">

    <!-- LEFT: Clock Display -->
    <FrameLayout
        android:id="@+id/clock_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2">

        <!-- Digital Clock -->
        <LinearLayout
            android:id="@+id/layout_digital_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/date_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, MMM dd"
                android:textAllCaps="true"
                android:letterSpacing="0.2"
                android:textColor="#888888"
                android:textSize="@dimen/_10ssp"
                android:singleLine="true"
                android:maxLines="1" />

            <TextClock
                android:id="@+id/text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:format12Hour="hh:mm"
                android:shadowColor="@color/pinkPrimary"
                android:shadowRadius="25"
                android:textColor="@color/white"
                android:textSize="@dimen/_65ssp"
                android:singleLine="true"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_timezone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local Time"
                android:textColor="#444444"
                android:textSize="@dimen/_9ssp"
                android:singleLine="true"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Analog Clock -->
        <LinearLayout
            android:id="@+id/layout_classic_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <com.nzdeveloper.androidclock.alarmtimer.stopwatch.widget.AnalogClockView
                android:id="@+id/analog_view"
                android:layout_width="@dimen/_180sdp"
                android:layout_height="@dimen/_180sdp" />
        </LinearLayout>
    </FrameLayout>

    <!-- RIGHT: Info + Toggle Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingEnd="@dimen/_20sdp">

        <TextView
            android:id="@+id/tv_clock_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.3"
            android:text="PRECISION IN EVERY SECOND"
            android:textColor="@color/pinkPrimary"
            android:textSize="@dimen/_8ssp"
            android:textAllCaps="true"
            android:singleLine="true"
            android:maxLines="1"
            android:layout_marginBottom="@dimen/_20sdp"/>

        <!-- Toggle: Digital / Classic -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/clock_toggle_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1B1B1F"
            app:cardCornerRadius="@dimen/_50sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/_4sdp">

                <TextView
                    android:id="@+id/btn_digital"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_pink"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="Digital"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/_10ssp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusRight="@id/btn_classic"/>

                <TextView
                    android:id="@+id/btn_classic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="Classic"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10ssp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@id/btn_digital"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
