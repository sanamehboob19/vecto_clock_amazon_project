<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1113"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_16sdp">

        <!-- 1. Header Section -->
        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/semibold_18"
            android:text="Discover More"
            android:textColor="@color/white"
            android:textSize="@dimen/_18ssp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_sub_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/regular_18"
            android:text="Enhance your utility experience"
            android:textColor="#666666"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_greeting" />

        <!-- 2. Hero Feature: Bedtime Mode -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_bedtime_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@id/card_world_clock"
            app:cardBackgroundColor="#1B1B1F"
            app:cardCornerRadius="@dimen/_22sdp"
            app:cardElevation="0dp"
            app:strokeColor="#221F1F"
            app:strokeWidth="1.2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_sub_greeting">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_18sdp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/icon_bg_bedtime"
                    android:layout_width="@dimen/_45sdp"
                    android:layout_height="@dimen/_45sdp"
                    app:cardBackgroundColor="#252129"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/_10sdp"
                        android:src="@drawable/ic_bedtime_moon"
                        app:tint="@color/pinkPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_bedtime_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:fontFamily="@font/semibold_18"
                    android:text="Bedtime Mode"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_15ssp"
                    app:layout_constraintStart_toEndOf="@id/icon_bg_bedtime"
                    app:layout_constraintTop_toTopOf="@id/icon_bg_bedtime" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/regular_18"
                    android:text="Build a healthier routine and wake up refreshed."
                    android:textColor="#888888"
                    android:textSize="@dimen/_9ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_bedtime_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_bedtime_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_bedtime"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_marginTop="@dimen/_18sdp"
                    android:fontFamily="@font/semibold_18"
                    android:text="Get Started"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    app:backgroundTint="@color/pinkPrimary"
                    app:cornerRadius="@dimen/_12sdp"
                    app:layout_constraintTop_toBottomOf="@id/icon_bg_bedtime" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Utilities Section -->
        <TextView
            android:id="@+id/tv_other_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_25sdp"
            android:letterSpacing="0.1"
            android:text="Utilities"
            android:textAllCaps="true"
            android:textColor="@color/pinkPrimary"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_bedtime_main" />

        <LinearLayout
            android:id="@+id/layout_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/tv_other_tools">

            <!-- World Clock -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_world_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@id/card_screen_saver"
                android:nextFocusUp="@id/card_bedtime_main"
                android:nextFocusDown="@id/card_widget_hub"
                app:cardBackgroundColor="#1B1B1F"
                app:cardCornerRadius="@dimen/_20sdp"
                app:cardElevation="0dp"
                app:strokeColor="#221F1F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_18sdp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_38sdp"
                        app:cardBackgroundColor="#212429"
                        app:cardCornerRadius="@dimen/_12sdp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:src="@drawable/ic_world_globe"
                            app:tint="#64B5F6" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/semibold_18"
                        android:text="World Clock"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Screen Saver -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_screen_saver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/card_world_clock"
                android:nextFocusUp="@id/card_bedtime_main"
                android:nextFocusDown="@id/card_widget_hub"
                app:cardBackgroundColor="#1B1B1F"
                app:cardCornerRadius="@dimen/_20sdp"
                app:cardElevation="0dp"
                app:strokeColor="#221F1F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_18sdp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_38sdp"
                        app:cardBackgroundColor="#292521"
                        app:cardCornerRadius="@dimen/_12sdp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:src="@drawable/ic_screen_saver"
                            app:tint="#FFD54F" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/semibold_18"
                        android:text="Night Stand"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 4. Wide Feature: Widget Gallery -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_widget_hub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/card_world_clock"
            app:cardBackgroundColor="#1B1B1F"
            app:cardCornerRadius="@dimen/_24sdp"
            app:cardElevation="0dp"
            app:strokeColor="#221F1F"
            app:strokeWidth="1.2dp"
            android:outlineSpotShadowColor="@color/pinkPrimary"
            app:layout_constraintTop_toBottomOf="@id/layout_grid">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_14sdp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/icon_bg"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_42sdp"
                    app:cardBackgroundColor="#252129"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/_10sdp"
                        android:src="@drawable/ic_widget_gallery" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
                    app:layout_constraintStart_toEndOf="@id/icon_bg"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/semibold_18"
                        android:text="Widget Gallery"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_13ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/regular_18"
                        android:text="Elegance for your home screen"
                        android:textColor="#666666"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_arrow"
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:alpha="0.4"
                    android:rotation="180"
                    android:src="@drawable/ic_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

