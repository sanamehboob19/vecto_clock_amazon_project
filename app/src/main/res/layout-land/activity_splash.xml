<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1113">

    <!-- Logo and Name Section -->
    <LinearLayout
        android:id="@+id/layout_logo_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/linearProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:src="@drawable/app_icon_logo"
            android:alpha="1" /> <!-- Testing ke liye alpha 1 rakhein -->

        <TextView
            android:id="@+id/tv_app_name"
            style="@style/h1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textSize="@dimen/_18ssp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.3"
            android:text="TIME, REDEFINED"
            android:textColor="@color/pinkPrimary"
            android:textSize="@dimen/_8ssp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/linearProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:progressDrawable="@drawable/gradient_progress"
        app:layout_constraintBottom_toTopOf="@+id/tv_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_logo_block" />

    <TextView
        android:id="@+id/tv_footer"
        style="@style/p4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="NZ DEVELOPER"
        android:textColor="#333333"
        android:letterSpacing="0.2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearProgress" />

</androidx.constraintlayout.widget.ConstraintLayout>
