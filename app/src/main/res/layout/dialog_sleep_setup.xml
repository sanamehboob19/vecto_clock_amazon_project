<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#121212"
    app:cardCornerRadius="@dimen/_20sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_20sdp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/iv_setup_icon"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_alarm"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center"
            android:text="Set a regular wake-up alarm"
            android:textColor="@color/white"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/_20sdp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_minus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                app:icon="@drawable/ic_minus"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:strokeColor="#333333"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:gravity="bottom">
                <TextView
                    android:id="@+id/tv_setup_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:15"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_45ssp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_setup_am_pm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="AM"
                    android:textColor="#FFB6C1"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_plus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:strokeColor="#333333"
                app:icon="@drawable/ic_plus"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_setup_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_sun" style="@style/DayCircleStyle" android:text="S" />
            <TextView android:id="@+id/day_mon" style="@style/DayCircleStyle" android:text="M" />
            <TextView android:id="@+id/day_tue" style="@style/DayCircleStyle" android:text="T" />
            <TextView android:id="@+id/day_wed" style="@style/DayCircleStyle" android:text="W" />
            <TextView android:id="@+id/day_thu" style="@style/DayCircleStyle" android:text="T" />
            <TextView android:id="@+id/day_fri" style="@style/DayCircleStyle" android:text="F" />
            <TextView android:id="@+id/day_sat" style="@style/DayCircleStyle" android:text="S" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/iv_feature_icon"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_wakeup_sun"
                    app:tint="@color/white"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iv_feature_icon"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_toStartOf="@id/switch_feature"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_feature_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunrise Alarm"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_feature_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Slowly brighten screen before alarm"
                        android:textColor="#888888"
                        android:textSize="@dimen/_10ssp"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_feature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:trackTint="@color/switch_track_selector"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_25sdp"
            android:gravity="end"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_skip"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skip"
                android:textColor="#888888" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="Next"
                android:textColor="@color/black"
                app:backgroundTint="#FFB6C1"
                app:cornerRadius="@dimen/_20sdp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>