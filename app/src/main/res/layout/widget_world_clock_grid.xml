<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_world_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dark"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/layout_empty_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No cities selected"
            android:fontFamily="@font/regular_18"
            android:textColor="#666666"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to add"
            android:fontFamily="@font/semibold_18"
            android:textColor="@color/pinkPrimary"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_cities_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- City Slot 1 -->
            <LinearLayout
                android:id="@+id/slot1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:text="CITY NAME"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="@dimen/_9ssp" />

                <TextClock
                    android:id="@+id/time1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semibold_18"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_18ssp" />

                <TextView
                    android:id="@+id/diff1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="@dimen/_8ssp"
                    android:text="-5h"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Vertical Divider 1 -->
            <FrameLayout
                android:id="@+id/v_div1"
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#2C2C2C"
                android:visibility="visible" />

            <!-- City Slot 2 -->
            <LinearLayout
                android:id="@+id/slot2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/name2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:text="CITY NAME"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="@dimen/_9ssp" />

                <TextClock
                    android:id="@+id/time2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semibold_18"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_18ssp" />

                <TextView
                    android:id="@+id/diff2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="@dimen/_8ssp"
                    android:text="-5h"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Horizontal Divider -->
        <FrameLayout
            android:id="@+id/h_div"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="#2C2C2C"
            android:visibility="visible" />


        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- City Slot 3 -->
            <LinearLayout
                android:id="@+id/slot3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:text="CITY NAME"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="@dimen/_9ssp" />

                <TextClock
                    android:id="@+id/time3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semibold_18"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_18ssp" />

                <TextView
                    android:id="@+id/diff3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="@dimen/_8ssp"
                    android:text="-5h"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Vertical Divider 2 -->
            <FrameLayout
                android:id="@+id/v_div2"
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#2C2C2C"
                android:visibility="visible" />


            <!-- City Slot 4 -->
            <LinearLayout
                android:id="@+id/slot4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:text="CITY NAME"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="@dimen/_9ssp" />

                <TextClock
                    android:id="@+id/time4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semibold_18"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_18ssp" />

                <TextView
                    android:id="@+id/diff4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="@dimen/_8ssp"
                    android:text="-5h"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>