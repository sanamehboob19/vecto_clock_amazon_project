<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1113">

    <TextView
        android:id="@+id/tv_ringing_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:text="10:00"
        android:textColor="#E2E2E6"
        android:textSize="@dimen/_65ssp"
        app:layout_constraintBottom_toTopOf="@+id/tv_alarm_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_alarm_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="Alarm"
        android:textColor="#C4C6D0"
        android:textSize="@dimen/_16ssp"
        app:layout_constraintBottom_toTopOf="@+id/container_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_ringing_time" />

    <FrameLayout
        android:id="@+id/container_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_60sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ========================================== -->
        <!-- MODE A: TAP UI (Two Big Oval Buttons)      -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layout_tap_ui"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_20sdp"
            android:visibility="gone"
            android:weightSum="2"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tap_snooze"
                android:layout_width="0dp"
                android:layout_height="@dimen/_60sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_weight="1"
                android:text="Snooze"
                android:textAllCaps="false"
                android:textColor="#D0BCFF"
                android:textSize="@dimen/_14ssp"
                app:backgroundTint="#38334D"
                app:cornerRadius="@dimen/_100sdp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tap_stop"
                android:layout_width="0dp"
                android:layout_height="@dimen/_60sdp"
                android:layout_weight="1"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="#E2E2E6"
                android:textSize="@dimen/_14ssp"
                app:backgroundTint="#2E3033"
                app:cornerRadius="@dimen/_100sdp" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- MODE B: SWIPE UI (Pill Slider)             -->
        <!-- ========================================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_swipe_ui"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginHorizontal="@dimen/_25sdp"
            android:background="@drawable/bg_swipe_track"
            android:visibility="gone"
            tools:visibility="gone">

            <!-- Background Snooze Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_25sdp"
                android:text="Snooze"
                android:textColor="#C4C6D0"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Background Stop Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_25sdp"
                android:text="Stop"
                android:textColor="#C4C6D0"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- DRAGGABLE THUMB (The Alarm Icon) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iv_swipe_thumb"
                android:layout_width="@dimen/_75sdp"
                android:layout_height="@dimen/_50sdp"
                app:cardBackgroundColor="#004A77"
                app:cardCornerRadius="@dimen/_100sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_alarm"
                    app:tint="@color/white" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


