<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color when the switch is ON (Checked) -->
    <item android:state_checked="true" android:color="@color/pinkPrimary" />

    <!-- Color when the switch is OFF (Unchecked) -->
    <item android:state_checked="false" android:color="@color/colorPrimary" />
</selector>