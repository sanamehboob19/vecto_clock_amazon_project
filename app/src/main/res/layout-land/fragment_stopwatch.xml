<?xml version="1.0" encoding="utf-8"?>
<!-- LANDSCAPE: fragment_stopwatch.xml — Left=Time display, Right=Laps+Controls -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1113"
    android:orientation="horizontal"
    android:padding="@dimen/_12sdp">

    <!-- ════ LEFT SIDE: Hero Time Display ════ -->
    <FrameLayout
        android:id="@+id/display_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2">

        <!-- Background Neon Glow -->
        <View
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_200sdp"
            android:layout_gravity="center"
            android:alpha="0.1"
            android:background="@drawable/bg_clock_aura" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_stopwatch_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:text="00:00.00"
                android:textColor="@color/white"
                android:textSize="@dimen/_50ssp"
                android:shadowColor="@color/pinkPrimary"
                android:shadowRadius="15"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:text="ELAPSED TIME"
                android:textColor="#333333"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- ════ RIGHT SIDE: Laps & Controls ════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/_15sdp">

        <!-- Laps Card Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#161618"
            app:cardCornerRadius="@dimen/_18sdp"
            app:cardElevation="0dp"
            app:strokeColor="#221F1F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_10sdp"
                    android:paddingStart="@dimen/_12sdp"
                    android:text="RECENT LAPS"
                    android:textColor="#444444"
                    android:textSize="@dimen/_7ssp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_lap_hint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="@dimen/_15sdp"
                        android:text="Tap Lap to record\na split time."
                        android:textColor="#333333"
                        android:textSize="@dimen/_10ssp"
                        android:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_laps"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Controls Section (TV Focusable) -->
        <LinearLayout
            android:id="@+id/bottom_controls_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_stop"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:text="Start"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/_13ssp"
                android:fontFamily="@font/semibold_18"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:backgroundTint="@color/pinkPrimary"
                android:nextFocusLeft="@id/btn_stopwatch"
                android:nextFocusDown="@id/btn_reset"
                app:cornerRadius="@dimen/_14sdp"
                app:elevation="@dimen/_4sdp"
                android:outlineSpotShadowColor="@color/pinkPrimary" />

            <LinearLayout
                android:id="@+id/layout_secondary_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:text="Reset"
                    android:fontFamily="@font/semibold_18"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:focusableInTouchMode="true"
                    app:backgroundTint="#1B1B1F"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_stopwatch"
                    android:nextFocusUp="@id/btn_start_stop"
                    android:nextFocusRight="@id/btn_lap"
                    app:cornerRadius="@dimen/_12sdp"
                    app:strokeColor="#2C2C2C"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lap"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:text="Lap"
                    android:fontFamily="@font/semibold_18"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:focusableInTouchMode="true"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_reset"
                    android:nextFocusUp="@id/btn_start_stop"
                    app:backgroundTint="#1B1B1F"
                    app:cornerRadius="@dimen/_12sdp"
                    app:strokeColor="#2C2C2C"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>